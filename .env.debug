# Debug mode loaded by `npm run dev:debug` / `npm run build:debug` (Vite `--mode debug`).
# You can also toggle it per-session with ?sdbdebug=1 / ?sdbdebug=0 in the URL.

# Enables the SpacetimeDB runtime trace + floating overlay.
VITE_SDB_DEBUG=true

# Report main-thread tasks and spans slower than this value (milliseconds).
VITE_SDB_TRACE_SLOW_MS=50
